+const DATA_VERSION = '26.1'
+const isTargetDataVersion = (req) => {
+  // 必须检查 req.request（完整相对路径，含版本目录）：
+  // req.context 是发起 require 的模块目录（minecraft-data 根），不含版本信息，会导致全部被误裁剪
