# VMTools Next — 环境变量模板
# 复制此文件为 .env 并修改: cp .env.example .env
#
# ⚠️ 2026-10-20 审查修复（严重·默认口令）：
#   原模板写 SITE_ADMIN_PASSWORD=change-me，而 start.sh 会自动
#   `cp .env.example .env` 并在用户直接回车后继续启动 —— 首次部署若没手工改，
#   生产就会用「admin / change-me」这对**公开在仓库里的默认口令**暴露 site_admin
#   （site_admin 可读全部密钥、管理全部成员、控制全部 bot）。
#   start.sh 已同步修复：检测到占位值时自动生成随机口令并回写 .env。
#   请勿在此模板里填写真实口令。

# === 安全（必须修改） ===
VMT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# === 管理员账号 ===
SITE_ADMIN_GAME_ID=admin
# 留空 = 由后端随机生成并在启动日志中打印一次（推荐）；
# 或自行填写强口令。切勿保留 change-me 之类的占位值。
SITE_ADMIN_PASSWORD=

# === 服务端口 ===
VMT_PORT=8080

# === MCC 程序配置 ===
# MCC 程序目录（存放 MinecraftClient.exe/dll）
MCC_RUNTIME_PATH=/opt/vmtools/mcc-runtime
# MCC 实例数据目录
MCC_INSTANCE_ROOT=/opt/vmtools/mcc-instances
# MCC MCP 端口范围
MCC_PORT_RANGE=33333-33352

# === 数据持久化 ===
# 数据默认存储在 Docker volume vmtools-data 和 vmtools-logs 中

# === 时装系统（VMFashion mod）===
# 皮肤站白名单（逗号分隔，可多个）。客户端上报的 authServer 只在这个名单内才会被使用。
VMT_FASHION__YGGDRASIL_BASES=https://littleskin.cn/api/yggdrasil
# 资产目录（相对仓库根目录；生产建议挂载持久卷）
VMT_FASHION__ASSET_DIR=data/fashion-assets
# mod token 有效期（秒）
VMT_FASHION__TOKEN_TTL_SECONDS=86400
# 设备码（网页绑定）轮询间隔（秒）
VMT_FASHION__DEVICE_POLL_INTERVAL_SECONDS=3
# 时装包 Ed25519 签名私钥（base64：裸 32 字节种子或 PKCS#8 DER）。留空 = 清单不带
# signature 字段。⚠️ 留空时**不要**在客户端 trusted_keys.json 里开 requireSignature，
# 否则客户端会拒绝全部服务端包（fail-closed）。私钥只能放服务端，绝不进 git。
VMT_FASHION__PACK_SIGNING_KEY_B64=
# 与客户端 trusted_keys.json 的 keys[].id 对应（密钥轮换用）
VMT_FASHION__PACK_SIGNING_KEY_ID=vmtools-official
