# VMTools Next — 环境变量模板
# 复制此文件为 .env 并修改: cp .env.example .env
#
# ⚠️ 2026-10-20 审查修复（严重·默认口令）：
#   原模板写 SITE_ADMIN_PASSWORD=change-me，而 start.sh 会自动
#   `cp .env.example .env` 并在用户直接回车后继续启动 —— 首次部署若没手工改，
#   生产就会用「admin / change-me」这对**公开在仓库里的默认口令**暴露 site_admin
#   （site_admin 可读全部密钥、管理全部成员、控制全部 bot）。
#   start.sh 已同步修复：检测到占位值时自动生成随机口令并回写 .env。
#   请勿在此模板里填写真实口令。

# === 安全（必须修改） ===
VMT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# === 管理员账号 ===
SITE_ADMIN_GAME_ID=admin
# 留空 = 由后端随机生成并在启动日志中打印一次（推荐）；
# 或自行填写强口令。切勿保留 change-me 之类的占位值。
SITE_ADMIN_PASSWORD=

# === 服务端口 ===
VMT_PORT=8080

# === MCC 程序配置 ===
# MCC 程序目录（存放 MinecraftClient.exe/dll）
MCC_RUNTIME_PATH=/opt/vmtools/mcc-runtime
# MCC 实例数据目录
MCC_INSTANCE_ROOT=/opt/vmtools/mcc-instances
# MCC MCP 端口范围
MCC_PORT_RANGE=33333-33352

# === 数据持久化 ===
# 数据默认存储在 Docker volume vmtools-data 和 vmtools-logs 中
