+        /// <summary>
+        /// Whether this protocol version expects a serverbound client_tick_end packet at the end
+        /// of every client tick (vanilla behaviour since 1.21.2).
+        /// </summary>
+        private bool SendsClientTickEnd => protocolVersion >= MC_1_21_2_Version && protocolVersion <= MC_26_2_Version;
+
+        /// <summary>
+        /// Send the serverbound client_tick_end packet that terminates the current client tick.
+        /// MC 26.3 servers enforce "one movement packet per client tick" and reset that counter
+        /// only when client_tick_end arrives; without it every bot is kicked ~1-2s after joining
+        /// with "Invalid move player packet received" (multiplayer.disconnect.invalid_player_movement).
+        /// </summary>
+        private void SendClientTickEnd()
+        {
+            if (!SendsClientTickEnd || currentState != CurrentState.Play)
+                return;
+
+            try
+            {
+                SendPacket(PacketTypesOut.ClientTickEnd, []);
+            }
+            catch (SocketException)
+            {
+                // connection already gone; the reader thread will report the disconnect
+            }
+            catch (System.IO.IOException)
+            {
+            }
+        }
+
